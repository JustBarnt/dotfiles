{
  // Omarchy menu for Windows, generated by tools/build-menu.py. The full Arch/Hyprland menu is in
  // omarchy-menu.upstream.jsonc. Add your own rows in ~/.config/omarchy/extensions/omarchy-menu.jsonc.

  // Root Menu
  "apps": {"icon": "󰀻", "label": "Apps", "aliases": ["app", "applications"], "provider": "apps"},
  "appearance": {"icon": "󰏘", "label": "Style", "aliases": ["style"]},
  "appearance.theme": {"icon": "󰸌", "label": "Theme", "aliases": ["theme", "themes"], "action": "omarchy-shell shell summon omarchy.image-picker '{\"source\":\"themes\"}'"},
  "appearance.background": {"icon": "", "label": "Background", "aliases": ["background", "wallpaper"], "action": "omarchy-shell shell summon omarchy.image-picker '{\"source\":\"wallpapers\"}'"},
  "trigger": {"icon": "󱓞", "label": "Trigger"},
  "trigger.emoji": {"icon": "", "label": "Emoji", "aliases": ["emoji"], "action": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$OMARCHY_PATH/tools/winkeys.ps1\" emoji 400"},
  "trigger.clipboard": {"icon": "󰅇", "label": "Clipboard history", "aliases": ["clipboard"], "action": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$OMARCHY_PATH/tools/winkeys.ps1\" clipboard 400"},
  "setup": {"icon": "", "label": "Setup", "aliases": ["settings"]},
  "setup.audio": {"icon": "󰕾", "label": "Audio", "action": "omarchy-shell shell summon omarchy.audio '{}'"},
  "setup.bluetooth": {"icon": "󰂯", "label": "Bluetooth", "action": "omarchy-shell shell summon omarchy.bluetooth '{}'"},
  "setup.network": {"icon": "󰛳", "label": "Network", "aliases": ["network"], "action": "omarchy-shell shell summon omarchy.network '{}'"},
  "setup.power": {"icon": "󰁹", "label": "Power", "action": "omarchy-shell shell summon omarchy.power '{}'"},
  "setup.windows-settings": {"icon": "󰒓", "label": "Windows Settings", "action": "explorer.exe ms-settings:"},
  "about": {"icon": "", "label": "About", "action": "explorer.exe ms-settings:about"},
  "system": {"icon": "", "label": "System", "aliases": ["power-menu"]},
  "system.lock": {"icon": "", "label": "Lock", "action": "rundll32.exe user32.dll,LockWorkStation"},
  "system.sleep": {"icon": "󰒲", "label": "Sleep", "action": "rundll32.exe powrprof.dll,SetSuspendState 0,1,0"},
  "system.logout": {"icon": "󰍃", "label": "Sign out", "action": "shutdown.exe //l"},
  "system.reboot": {"icon": "󰜉", "label": "Restart", "action": "shutdown.exe //r //t 0"},
  "system.shutdown": {"icon": "󰐥", "label": "Shut down", "action": "shutdown.exe //s //t 0"}
}
