[
  {
    "name": "vim",
    "displayName": "Vim Mode",
    "repo": "https://github.com/eugenioenko/ttt-vim",
    "version": "0.1.0",
    "enabled": true,
    "permissions": {
      "commands": true,
      "keybindings": true,
      "editor.read": true,
      "editor.write": true,
      "fs.write": true,
      "network.http": false,
      "settings": true,
      "settings_keys": [
        "vim.enabled",
        "vim.clipboard"
      ]
    }
  }
]