    "query": "set nocount on\nGO\n\ndeclare @agencyId bigint\n\nset @agencyId = 1\n\nbegin transaction\n\n-- Wipe existing Authentication configuration\ndelete from tblAgencyConfiguration\nwhere agencyId = @agencyId and path like '/config/agency/authenticate%'\n\n-- Add new authentication settings\ninsert into tblAgencyConfiguration (agencyId, [path], [value])\n      select @agencyId, '/config/agency/authenticate/Ldap/serverUrl',    'ldap://ad.commsys.com'                       -- Must be of the form 'ldap://HOST:PORT' or 'ldaps://HOST:PORT'\nunion select @agencyId, '/config/agency/authenticate/Ldap/serverPort',   ''                       -- Leave blank\nunion select @agencyId, '/config/agency/authenticate/Ldap/failoverUrl',  'ldap://ad.commsys.com'                       -- Must be of the form 'ldap://HOST:PORT' or 'ldaps://HOST:PORT'\nunion select @agencyId, '/config/agency/authenticate/Ldap/failoverPort', ''                       -- Leave blank\nunion select @agencyId, '/config/agency/authenticate/Ldap/bind',         'bwilliams'                       -- LDAP Service Account User\nunion select @agencyId, '/config/agency/authenticate/Ldap/bindPassword', 'g3ng4r0309!!'                       -- LDAP Service Account Password\nunion select @agencyId, '/config/agency/authenticate/Ldap/root',         'DC=ad, DC=commsys, DC=com'                       -- Root LDAP DN to bind to when searching for users\nunion select @agencyId, '/config/agency/authenticate/Ldap/filter',       ''                       -- LDAP filter which restricts the users searched when looking for a user login\nunion select @agencyId, '/config/agency/authenticate/Ldap/protocol',     '3'                      -- Don't change this.\nunion select @agencyId, '/config/agency/authenticate/Ldap/referrals',    '0'                      -- Don't change this unless needed. Allows LDAP referrals to other LDAP servers\nunion select @agencyId, '/config/agency/authenticate/Ldap/manageUsers',  '1'                      -- Set to 0 to disable CLIPS user management UIs\nunion select @agencyId, '/config/agency/authenticate/Ldap/userField',    'samaccountname'         -- Don't change this if we're talking to ActiveDirectory\nunion select @agencyId, '/config/agency/authenticate/Ldap/captureFields/memberships',  'memberof' -- Uncomment this to allow capturing of AD groups as CLIPS permission groups\n-- union select @agencyId, '/config/agency/authenticate/Ldap/sysAdminGroup','Development Group'                       -- Uncomment to this to allow System Administrators to be identified by the\n                                                                                                    -- specified AD group. REQUIRES captureFields to be enabled.\n-- union select @agencyId, '/config/agency/authenticate/createUser', '' \t\t\t\t\t\t\t\t-- Uncomment this section to allow User Creation through LDAP\n\ncommit transaction\n\nset nocount off\nGO",
